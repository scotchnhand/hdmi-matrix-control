      "window": { "before": 0, "after": 0 },
      "palette": {
        "dark": { "accent": "#4de8f0", "accent-text": "#00272a", "bg": "#070a14", "glow-a": "#00e5ff", "glow-b": "#c13cff" },
        "light": { "accent": "#005f69", "accent-text": "#ffffff", "bg": "#eef3f7", "glow-a": "#00b8d4", "glow-b": "#c13cff" }
      }
    },
    {
